PORT=3000
DATA_DIR=./data
# Internal-only Docker port. Nginx exposes the application through HTTPS.
APP_PORT=8213

# Password for the admin panel (leaderboard clear/import/export, questions
# editor, activity report). There is no default: leave it unset and the
# maintenance actions stay disabled while the quiz keeps running.
ADMIN_PASSWORD=

# Optional ISO-8601 window used to split Activity Report into before/during/after.
# EVENT_START_AT=2026-09-15T08:00:00+02:00
# EVENT_END_AT=2026-09-15T18:00:00+02:00

# Anonymous activity events older than this are removed at server startup.
ACTIVITY_RETENTION_DAYS=180
